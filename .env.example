# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU CHO SMASH VN SHOP
# Sao chép file này thành .env và điền các thông tin phù hợp
# ==========================================

# Cấu hình Kết nối Cơ sở dữ liệu SQL Server
DB_USERNAME= 
DB_PASSWORD=

# Cấu hình Mail Service (Gmail SMTP)
GMAIL_USERNAME=
GMAIL_PASSWORD=

# Cấu hình Google OAuth2 Client
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET= 
# Danh sách Email Admin (nhận thông báo phê duyệt khóa tài khoản, phân tách bằng dấu phẩy)
APP_ADMIN_EMAILS= 
# Đường dẫn tuyệt đối của thư mục lưu ảnh tải lên (bắt buộc kết thúc bằng dấu '/')
# Ví dụ Windows: C:/uploads/product/
# Ví dụ Linux: /var/www/smashvn/uploads/product/
APP_UPLOAD_PATH= 

# Cấu hình Hibernate (Tùy chọn, mặc định: true và update cho local dev)
SPRING_JPA_SHOW_SQL= 
SPRING_JPA_DDL_AUTO= 
