{
  "entity": "PaymentTransaction",
  "table": "GiaoDichThanhToan",
  "gateways": {
    "SePay": {
      "integration": "IPN Webhook Callback (/api/payment/sepay/ipn)",
      "memoRegex": "(HDSVN|DHSVN|DH)[-_\\s]*[A-Z0-9]+"
    },
    "ZaloPay": {
      "integration": "REST SDK + Callback API (/api/payment/zalopay/callback)",
      "signature": "HMAC-SHA256"
    },
    "COD": "PhuongThucThanhToan",
    "POS": "In-Store immediate capture"
  },
  "stateTransitions": {
    "orderCreated": "paymentStatus: PENDING, orderStatus: cho_thanh_toan",
    "paymentSuccess": "paymentStatus: PAID, orderStatus: cho_xac_nhan / stock_conflict",
    "paymentAfterCancel": "paymentStatus: PAID_RECEIVED_AFTER_CANCEL, orderStatus: da_huy (Urgent Admin Alert)",
    "refundApproved": "paymentStatus: REFUNDED, refundStatus: COMPLETED"
  }
}